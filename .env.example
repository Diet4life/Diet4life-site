# Server-side only -- read exclusively by netlify/functions/contact-submit.ts
# via process.env. Never referenced from client-side code, never committed
# with a real value. Set the real key in Netlify: Site settings ->
# Environment variables.
RESEND_API_KEY=

# Server-side only -- read exclusively by netlify/functions/payments-initiate.ts
# via process.env. Never referenced from client-side code, never committed
# with real values. SANDBOX values only, set in Netlify scoped to Deploy
# Previews + Branch deploys -- Production is left unset on purpose so
# isProductionContext() has nothing to work with even if that guard were
# ever bypassed. See CLAUDE.md's NETOPIA section for the current scope.
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=

# Server-side only -- read exclusively by verifyNetopiaNotification() via
# netlify/functions/payments-netopia-notify.ts, to RS256-verify the JWT
# NETOPIA sends in the "Verification-token" header on every IPN/notify
# call. This is NETOPIA's own RSA PUBLIC key (a PEM string, e.g.
# "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"), obtained
# from NETOPIA's merchant dashboard -- not something this codebase can
# invent or derive. Until this is set to the real value, every
# notification fails closed at the public_key_not_configured check and no
# order can ever be marked paid via notify -- this is deliberate, not a
# bug: see netopiaVerification.ts's header comment. SANDBOX value only,
# same scope as NETOPIA_API_KEY/NETOPIA_POS_SIGNATURE (Deploy Previews +
# Branch deploys, Production left unset).
NETOPIA_PUBLIC_KEY=

# Server-side only -- read exclusively by resolveSiteBaseUrl() in
# netlify/functions/payments-initiate.ts, to build config.notifyUrl/
# config.redirectUrl. Not a secret, but must be set by hand: Netlify's
# CONTEXT/DEPLOY_URL/DEPLOY_PRIME_URL build-time variables were confirmed
# (via a real Function invocation's logs) to be unavailable in the
# Functions runtime, so there is no way to derive the branch-deploy's own
# URL automatically there. Set this in Netlify scoped to Branch deploys
# only (never Production) to the exact branch-deploy URL, e.g.
# https://claude-tool-usage-check-htkbjz--diet4life.netlify.app -- must be
# a valid https:// URL or it's ignored (see isValidHttpsUrl()). Leaving
# Production unset is deliberate: resolveSiteBaseUrl() ignores this
# variable entirely in production regardless, so an accidental value here
# could never affect the live site.
D4L_SITE_BASE_URL=

# Server-side only -- read exclusively by resolveNotifyBaseUrl() in
# netlify/functions/payments-initiate.ts, to build config.notifyUrl
# SPECIFICALLY (config.redirectUrl keeps using D4L_SITE_BASE_URL above,
# unaffected by this variable). Not a secret, but must be set by hand, same
# as D4L_SITE_BASE_URL. Exists because Netlify's Visitor Access/team-SSO
# gate on this site cannot be made public on the current plan (confirmed by
# the user in her own dashboard) and was confirmed, via a real failed
# sandbox notification, to return HTTP 401 to NETOPIA's server-to-server
# notify POST before payments-netopia-notify.ts ever runs -- redirectUrl
# doesn't have this problem since the browser's own session on the branch
# deploy is already authenticated via team SSO. Set this to a SECOND,
# separate Netlify site's URL (same repo/branch, deployed independently,
# with that second site's own Visitor Access left public) that exists only
# to receive and relay sandbox NETOPIA notifications -- see CLAUDE.md's
# NETOPIA section and the accompanying report for the manual dashboard
# steps this requires (creating that second site is not something this
# codebase can do on its own). Must be a valid https:// URL or it's
# ignored, in which case notifyUrl silently falls back to
# D4L_SITE_BASE_URL/URL, i.e. today's behavior with this variable unset.
# SANDBOX only, same scope as the other NETOPIA_* variables (Deploy
# Previews + Branch deploys, Production left unset and never read).
D4L_NETOPIA_NOTIFY_BASE_URL=
